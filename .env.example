# ============================================================
# ShelterOps AI - environment variables
# 1. Copy this file and rename the copy to:  .env
# 2. Get a FREE Gemini API key at: https://aistudio.google.com/apikey
#    (sign in with Google -> "Create API key" -> copy it)
# 3. Paste your key below. No credit card needed.
#    (Everything also works without a key - offline analyst kicks in.)
# ============================================================

GEMINI_API_KEY=your_key_here

# Optional: which Gemini model to use (free tier friendly)
GEMINI_MODEL=gemini-2.5-flash

# Optional: server port (default 5000). Set to 5001 if 5000 is busy.
# PORT=5000
